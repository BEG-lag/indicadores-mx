{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beg-lag.github.io/indicadores-mx/schema/v1/compact.schema.json",
  "title": "Compact series (API v1)",
  "description": "/v1/<series>/compact.json: parallel arrays of dates and values, without sources. Meant for charts; use all.json for provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["series", "unit", "dates", "values"],
  "properties": {
    "series": { "type": "string" },
    "unit": { "type": "string" },
    "dates": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" } },
    "values": { "type": "array", "items": { "type": "number" } }
  }
}
