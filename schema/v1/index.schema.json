{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beg-lag.github.io/indicadores-mx/schema/v1/index.schema.json",
  "title": "Catalog (API v1)",
  "description": "/v1/index.json: every series with its metadata, coverage, latest value and endpoints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "api_version", "generated", "data_updated", "base_url", "repository", "license", "disclaimer", "total_observations", "series"],
  "properties": {
    "name": { "const": "indicadores-mx" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "api_version": { "const": "v1" },
    "generated": { "type": "string", "format": "date-time" },
    "data_updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "base_url": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "data"],
      "properties": { "code": { "const": "MIT" }, "data": { "const": "CC0-1.0" } }
    },
    "disclaimer": { "$ref": "series.schema.json#/$defs/text" },
    "total_observations": { "type": "integer", "minimum": 1 },
    "series": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "text": { "$ref": "series.schema.json#/$defs/text" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "short", "group", "kind", "frequency", "unit", "unit_label", "decimals", "issuer", "description", "date_meaning", "legal_basis", "status", "coverage", "latest", "sources", "endpoints"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "$ref": "#/$defs/text" },
        "short": { "$ref": "#/$defs/text" },
        "group": { "type": "string" },
        "kind": { "enum": ["daily", "monthly", "step"] },
        "frequency": { "$ref": "#/$defs/text" },
        "unit": { "type": "string" },
        "unit_label": { "$ref": "#/$defs/text" },
        "decimals": { "type": "integer", "minimum": 0 },
        "issuer": { "type": "string" },
        "description": { "$ref": "#/$defs/text" },
        "date_meaning": { "$ref": "#/$defs/text" },
        "legal_basis": { "$ref": "#/$defs/text" },
        "status": { "enum": ["VERDE", "AMARILLO", "ROJO"] },
        "derived_from": { "type": "string" },
        "ended": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first", "last", "count", "years", "with_dof_note", "checked_against_note"],
          "properties": {
            "first": { "type": "string" },
            "last": { "type": "string" },
            "count": { "type": "integer", "minimum": 1 },
            "years": { "type": "array", "items": { "type": "integer" } },
            "with_dof_note": { "type": "integer", "minimum": 0 },
            "checked_against_note": { "type": "integer", "minimum": 0 }
          }
        },
        "latest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "value"],
          "properties": { "date": { "type": "string" }, "value": { "type": "number" } }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "url"],
            "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "url": { "type": "string" } }
          }
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "required": ["latest", "all_json", "all_csv", "compact", "year"]
        }
      }
    }
  }
}
